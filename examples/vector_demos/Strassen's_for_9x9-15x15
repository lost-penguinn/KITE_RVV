main:

    # Change this value for each test: 9 to 15
    li s0, 9

    # Pointers to input matrices
    la t0, A
    la t1, B

    # i = 0
    li s1, 0

outer_loop:

    # j = 0
    li s2, 0

inner_loop:

    # A[i][j] = i - j - 2
    sub t2, s1, s2
    addi t2, t2, -2
    sw t2, 0(t0)

    # B[i][j] = j - i + 1
    sub t3, s2, s1
    addi t3, t3, 1
    sw t3, 0(t1)

    # Advance to next element
    addi t0, t0, 4
    addi t1, t1, 4

    # j++
    addi s2, s2, 1
    blt s2, s0, inner_loop

    # i++
    addi s1, s1, 1
    blt s1, s0, outer_loop

    # Set custom instruction arguments
    la a0, A
    la a1, B
    la a2, C
    mv a3, s0

    # Execute matrix multiplication
    vmatmul.strassen v0, v1, v2

end:
    j end


