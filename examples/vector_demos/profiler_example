.text
main:
    # Configure: SEW=32, LMUL=1, VL=4
    vsetvli t3, zero, 208

    # Load data-section addresses
    lui t0, 0x10000
    addi t1, t0, 16
    addi t2, t0, 32

    # Load arrays
    vle32.v v1, (t0)
    vle32.v v2, (t1)

    # Vector arithmetic
    vadd.vv v3, v1, v2
    vsub.vv v4, v1, v2
    vmul.vv v5, v1, v2

    # Reduction: sum of v3
    vredsum.vs v6, v3, v0

    # Store addition result
    vse32.v v3, (t2)

end:
    addi x0, x0, 0